<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Notchy</AssemblyName>
    <RootNamespace>Notchy</RootNamespace>
    <Product>Notchy</Product>
    <!-- Major.minor here; the build number comes from GitHub Actions (each push = a new release). -->
    <Version>2.2.0</Version>
    <ApplicationIcon>Notchy.ico</ApplicationIcon>
    <!-- Custom Main (Program.cs) so the hook mode can run without starting WPF. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Notchy.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>


  <ItemGroup>
    <!-- GitHub repository the updater reads Releases from (set by the release workflow). -->
    <AssemblyMetadata Include="NotchyRepo" Value="$(NotchyRepo)" Condition="'$(NotchyRepo)' != ''" />
  </ItemGroup>

  <!-- The card shown during an update: a tiny separate program, carried inside Notchy and run from the temp folder. -->
  <PropertyGroup>
    <WindowsFramework>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319</WindowsFramework>
    <UpdateCardExe>$(MSBuildProjectDirectory)\obj\UpdateCard\UpdateCard.exe</UpdateCardExe>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="UpdateCard\**" />
    <EmbeddedResource Include="$(UpdateCardExe)" LogicalName="UpdateCard.exe" Visible="false" />
  </ItemGroup>
  <Target Name="BuildUpdateCard" BeforeTargets="BeforeBuild" Inputs="UpdateCard\UpdateCard.cs" Outputs="$(UpdateCardExe)">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\UpdateCard" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(WindowsFramework)\csc.exe&quot; /nologo /target:winexe /optimize+ /platform:anycpu /win32icon:Notchy.ico /out:&quot;$(UpdateCardExe)&quot; /r:&quot;$(WindowsFramework)\WPF\PresentationFramework.dll&quot; /r:&quot;$(WindowsFramework)\WPF\PresentationCore.dll&quot; /r:&quot;$(WindowsFramework)\WPF\WindowsBase.dll&quot; /r:&quot;$(WindowsFramework)\System.Xaml.dll&quot; UpdateCard\UpdateCard.cs" />
  </Target>

</Project>
