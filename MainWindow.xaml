                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="15" Height="15" CornerRadius="4" Background="{StaticResource ClaudeOrange}">
                                                <TextBlock Text="✻" FontFamily="Segoe UI Symbol" FontSize="9.5" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="ClaudeProject" FontSize="11.5" Foreground="#CCFFFFFF" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Name="ClaudeTimer" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,-2" />
                                        <TextBlock x:Name="ClaudeStatus" FontSize="11.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <Button x:Name="ClaudeOpenButton" Style="{StaticResource ClaudePill}" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" Click="ClaudeOpen_Click">
