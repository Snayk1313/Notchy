<Window x:Class="Notchy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notchy"
        Title="Notchy" Width="1000" Height="420" Left="0" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E6FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="el" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="el" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Separate little Claude island (shown left of the music pill while Claude works) -->
        <Border x:Name="ClaudePod" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-30,0,0"
                Width="70" Height="64" CornerRadius="17" Background="Black" BorderThickness="0"
                Opacity="0" Visibility="Collapsed" Cursor="Hand"
                RenderTransformOrigin="0.5,0" MouseLeftButtonUp="ClaudePod_Click">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PodScale" />
                    <TranslateTransform x:Name="PodX" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="PodContent" Margin="0,30,0,0" Height="34" VerticalAlignment="Top">
                <!-- faint orange outline + the little bar that runs around it while Claude works -->
                <Path x:Name="PodTrack" Stroke="#E8825F" StrokeThickness="1.6" Opacity="0.35" IsHitTestVisible="False" />
                <Path x:Name="PodArc" Stroke="#FF9A6E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeDashCap="Round" IsHitTestVisible="False" Visibility="Collapsed">
                    <Path.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.9" Color="#E8825F" />
                    </Path.Effect>
                </Path>
                <!-- the eyes can leave by the top edge (and come down from it): "behind the screen" -->
                <Grid ClipToBounds="True" IsHitTestVisible="False">
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PodTrip" />
                        </Grid.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PodLook" />
                            </StackPanel.RenderTransform>
                            <StackPanel.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.8" Color="#E8825F" />
                            </StackPanel.Effect>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="PodEyeL" Width="6" Height="10" Fill="#FFD9C4" RenderTransformOrigin="0.5,0.5" />
                                <Path x:Name="PodHappyL" Data="M0,7 Q4.5,0 9,7" Stroke="#FFD9C4" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="PodEyeR" Width="6" Height="10" Fill="#FFD9C4" RenderTransformOrigin="0.5,0.5" />
                                <Path x:Name="PodHappyR" Data="M0,7 Q4.5,0 9,7" Stroke="#FFD9C4" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- while the eyes pass from one bubble to the other behind the screen, a faint glow runs along its top edge -->
        <Border x:Name="EyeTripGlow" HorizontalAlignment="Center" VerticalAlignment="Top" Width="34" Height="2.6"
                CornerRadius="1.3" Opacity="0" IsHitTestVisible="False" Background="#FF9A6E">
            <Border.RenderTransform>
                <TranslateTransform x:Name="EyeTripGlowX" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="EyeTripGlowShadow" ShadowDepth="0" BlurRadius="10" Opacity="1" Color="#FF9A6E" />
            </Border.Effect>
        </Border>

        <!-- the green download bubble next to the island (music / Claude / Focus + a download) -->
        <Border x:Name="DownloadPod" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-30,0,0"
                Width="70" Height="64" CornerRadius="17" Background="Black" BorderThickness="0"
                Opacity="0" Visibility="Collapsed" Cursor="Hand" RenderTransformOrigin="0.5,0"
                MouseLeftButtonUp="DownloadPod_Click" MouseEnter="DownloadPod_MouseEnter" MouseLeave="Island_MouseLeave">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DlPodScale" />
                    <TranslateTransform x:Name="DlPodX" />
                    <TranslateTransform x:Name="DlPodSlide" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="DlPodContent" Margin="0,30,0,0" Height="34" VerticalAlignment="Top">
                <Path x:Name="DlPodTrack" Stroke="#5ED67D" StrokeThickness="1.6" Opacity="0.3" IsHitTestVisible="False" />
                <Path x:Name="DlPodArc" Stroke="#7CF0A0" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeDashCap="Round" IsHitTestVisible="False">
                    <Path.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.9" Color="#5ED67D" />
                    </Path.Effect>
                </Path>
                <!-- the island's download icon, only while the bubble turns into the island (or back) -->
                <TextBlock x:Name="DlPodIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#5ED67D"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" Opacity="0" IsHitTestVisible="False" />
                <!-- the bubble itself has no eyes (one pair on screen is enough): the %, a check when done -->
                <Grid x:Name="DlPodInfo" IsHitTestVisible="False">
                    <TextBlock x:Name="DlPodPct" FontSize="11" FontWeight="Bold" Foreground="#5ED67D"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="DlPodMid" FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="12" Foreground="#5ED67D"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Path x:Name="DlPodMark" Stroke="#7CF0A0" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Path.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.9" Color="#5ED67D" />
                        </Path.Effect>
                    </Path>
                </Grid>
                <!-- the eyes can leave by the top edge (and come down from it): "behind the screen" -->
                <Grid ClipToBounds="True" IsHitTestVisible="False">
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DlPodTrip" />
                        </Grid.RenderTransform>
                        <StackPanel x:Name="DlPodEyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="DlPodLook" />
                                    </StackPanel.RenderTransform>
                                    <StackPanel.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="9" Opacity="0.85" Color="#5ED67D" />
                                    </StackPanel.Effect>
                                    <Grid Width="10" Height="12" Margin="1,0">
                                        <Ellipse x:Name="DlEyeL" Width="6" Height="10" Fill="#9CF5B6" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="DlEyeLScale" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Path x:Name="DlHappyL" Data="M0,7 Q4.5,0 9,7" Stroke="#9CF5B6" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Width="10" Height="12" Margin="1,0">
                                        <Ellipse x:Name="DlEyeR" Width="6" Height="10" Fill="#9CF5B6" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="DlEyeRScale" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Path x:Name="DlHappyR" Data="M0,7 Q4.5,0 9,7" Stroke="#9CF5B6" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- In "attached" style the top 30px sit above the screen edge so only the bottom corners look rounded. -->
        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
                UseLayoutRounding="False"
                Margin="0,-30,0,0" Width="120" Height="60" Background="Black" CornerRadius="15"
                RenderTransformOrigin="0.5,0"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_MouseLeftButtonUp" MouseWheel="Island_MouseWheel"
                AllowDrop="True" DragEnter="Island_DragOver" DragOver="Island_DragOver" Drop="Island_Drop">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScale" />
            </Border.RenderTransform>
            <Grid x:Name="IslandContent">
                <Border x:Name="AccentGlow" Opacity="0" />

                <Grid x:Name="PanelsHost" Margin="0,30,0,0">

                    <!-- IDLE: two blinking eyes -->
                    <Grid x:Name="IdlePanel" Width="120" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <StackPanel x:Name="IdleEyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="EyesSleep" />
                                    <TranslateTransform x:Name="EyesLook" />
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <StackPanel.Effect>
                                <DropShadowEffect x:Name="EyesGlow" ShadowDepth="0" BlurRadius="9" Opacity="0" Color="White" />
                            </StackPanel.Effect>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="EyeL" Width="6" Height="10" Fill="White" RenderTransformOrigin="0.5,0.5" />
                                <Path x:Name="HappyL" Data="M0,7 Q4.5,0 9,7" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="EyeR" Width="6" Height="10" Fill="White" RenderTransformOrigin="0.5,0.5" />
                                <Path x:Name="HappyR" Data="M0,7 Q4.5,0 9,7" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- COMPACT: generic left | center | right -->
                    <Grid x:Name="CompactPanel" Width="340" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                          Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="CompactAlertDot" Width="7" Height="7" Fill="{StaticResource ClaudeOrange}"
                                     Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="CompactClaudeGlyph" Text="✻" FontFamily="Segoe UI Symbol" FontSize="15"
                                       Foreground="{StaticResource ClaudeOrange}" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.52" Margin="0,0,7,0" Visibility="Collapsed">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="ClaudeSpin" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="CompactIcon" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                            <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="#2A2A2A" />
                            <StackPanel x:Name="CompactFocusEyes" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Rectangle Width="6" Height="10" RadiusX="3" RadiusY="3" Fill="#B79CFF" Margin="0,0,5,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="CompactFocusEyeL" /></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="6" Height="10" RadiusX="3" RadiusY="3" Fill="#B79CFF" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="CompactFocusEyeR" /></Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="10,0" ClipToBounds="True">
                            <!-- StackPanel gives the text all the room it wants; the Grid clips it, so long lines can slide -->
                            <StackPanel x:Name="CompactTextHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CompactText" Foreground="White" FontWeight="SemiBold" FontSize="12.5" />
                            </StackPanel>
                            <StackPanel x:Name="CompactEyes" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse x:Name="EyeL2" Width="6" Height="10" Fill="White" Margin="3,0" RenderTransformOrigin="0.5,0.5" />
                                <Ellipse x:Name="EyeR2" Width="6" Height="10" Fill="White" Margin="3,0" RenderTransformOrigin="0.5,0.5" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <local:Visualizer x:Name="CompactViz" Width="28" Height="14" />
                                <TextBlock x:Name="CompactRight" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <!-- the bell while an alarm is set (MainWindow.AlarmHint.cs) -->
                            <Grid x:Name="CompactAlarm" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- COMPACT, after an update with notes: "✦ What's new in Notchy 2.0", happy golden eyes (MainWindow.WhatsNew.cs) -->
                    <Grid x:Name="WhatsNewPanel" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="WhatsNewSpark" Text="✦" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="#FFD36B"
                                       VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="WhatsNewSparkScale" />
                                        <RotateTransform x:Name="WhatsNewSparkRotate" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="WhatsNewText" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Margin="9,1,0,0" VerticalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="WhatsNewEyesBob" />
                                </StackPanel.RenderTransform>
                                <StackPanel.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.9" Color="#FFD36B" />
                                </StackPanel.Effect>
                                <Path Data="M0,6 Q4.5,0 9,6" Stroke="#FFD36B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,3,0" />
                                <Path Data="M0,6 Q4.5,0 9,6" Stroke="#FFD36B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="WhatsNewLine" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="26,0,26,1" Opacity="0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFD36B" Offset="0" />
                                    <GradientStop Color="#FFFFD36B" Offset="0.5" />
                                    <GradientStop Color="#00FFD36B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- COMPACT, download / copy alone on the island: icon, green eyes, % (MainWindow.Transfer.cs) -->
                    <Grid x:Name="TransferPanel" Width="200" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                          Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="TransferIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#5ED67D"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TransferLook" />
                            </StackPanel.RenderTransform>
                            <StackPanel.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="9" Opacity="0.85" Color="#5ED67D" />
                            </StackPanel.Effect>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="TransferEyeL" Width="6" Height="10" Fill="#9CF5B6" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="TransferEyeLScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path x:Name="TransferHappyL" Data="M0,7 Q4.5,0 9,7" Stroke="#9CF5B6" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="TransferEyeR" Width="6" Height="10" Fill="#9CF5B6" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="TransferEyeRScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path x:Name="TransferHappyR" Data="M0,7 Q4.5,0 9,7" Stroke="#9CF5B6" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="TransferPercent" Foreground="#5ED67D" FontWeight="Bold" FontSize="12.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" />
                    </Grid>

                    <!-- COMPACT, Claude working alone on the island: just orange eyes (MainWindow.ClaudeFace.cs) -->
                    <Grid x:Name="ClaudePanel" Width="160" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                          Opacity="0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="ClaudeLook" />
                            </StackPanel.RenderTransform>
                            <StackPanel.Effect>
                                <DropShadowEffect x:Name="ClaudeEyesGlow" ShadowDepth="0" BlurRadius="9" Opacity="0.85" Color="#FFB894" />
                            </StackPanel.Effect>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="ClaudeEyeL" Width="6" Height="10" Fill="#FFB894" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="ClaudeEyeLScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path x:Name="ClaudeHappyL" Data="M0,7 Q4.5,0 9,7" Stroke="#FFB894" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="ClaudeEyeR" Width="6" Height="10" Fill="#FFB894" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="ClaudeEyeRScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path x:Name="ClaudeHappyR" Data="M0,7 Q4.5,0 9,7" Stroke="#FFB894" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- VOLUME / BRIGHTNESS: the island fills with light; the output list opens below (MainWindow.VolumeIsland.cs) -->
                    <Grid x:Name="VolumePanel" Width="240" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                          Opacity="0" IsHitTestVisible="False" />

                    <!-- EXPANDED -->
                    <Grid x:Name="ExpandedPanel" Width="480" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <Grid Grid.Row="0" Margin="20,4,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock x:Name="HeaderA" FontSize="13" FontWeight="Bold" Foreground="White" />
                                <Grid>
                                    <!-- the glow (a copy underneath), then the crisp word on top -->
                                    <TextBlock x:Name="HeaderBGlow" FontSize="13" FontWeight="Bold" Foreground="#FFB060" IsHitTestVisible="False" />
                                    <TextBlock x:Name="HeaderB" FontSize="13" FontWeight="Bold" Foreground="#FFB060" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="HeaderClaudeDot" Width="6" Height="6" Fill="{StaticResource ClaudeOrange}"
                                         Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock FontSize="11.5" Foreground="#99FFFFFF" VerticalAlignment="Center">
                                    <Run x:Name="DateRun" /><Run Text="  " /><Run x:Name="TimeRun" Foreground="White" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="BatteryText" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="13"
                                        Padding="7,4" Click="MoreButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- tab content -->
                        <Grid Grid.Row="1" Margin="20,2,20,0">

                            <!-- HOME -->
                            <Grid x:Name="HomeTab" Height="118" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
