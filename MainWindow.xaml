<Window x:Class="Notchy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notchy"
        Title="Notchy" Width="1000" Height="420" Left="0" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E6FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="el" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="el" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Separate little Claude island (shown left of the music pill while Claude works) -->
        <Border x:Name="ClaudePod" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-30,0,0"
                Width="70" Height="64" CornerRadius="17" Background="Black" BorderThickness="0"
                Opacity="0" Visibility="Collapsed" Cursor="Hand"
                RenderTransformOrigin="0.5,0" MouseLeftButtonUp="ClaudePod_Click">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PodScale" />
                    <TranslateTransform x:Name="PodX" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="PodContent" Margin="0,30,0,0" Height="34" VerticalAlignment="Top">
                <!-- faint orange outline + the little bar that runs around it while Claude works -->
                <Path x:Name="PodTrack" Stroke="#E8825F" StrokeThickness="1.6" Opacity="0.35" IsHitTestVisible="False" />
                <Path x:Name="PodArc" Stroke="#FF9A6E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeDashCap="Round" IsHitTestVisible="False" Visibility="Collapsed">
                    <Path.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.9" Color="#E8825F" />
                    </Path.Effect>
                </Path>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="PodLook" />
                    </StackPanel.RenderTransform>
                    <StackPanel.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.8" Color="#E8825F" />
                    </StackPanel.Effect>
                    <Grid Width="10" Height="12" Margin="1,0">
                        <Ellipse x:Name="PodEyeL" Width="6" Height="10" Fill="#FFD9C4" RenderTransformOrigin="0.5,0.5" />
                        <Path x:Name="PodHappyL" Data="M0,7 Q4.5,0 9,7" Stroke="#FFD9C4" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <Grid Width="10" Height="12" Margin="1,0">
                        <Ellipse x:Name="PodEyeR" Width="6" Height="10" Fill="#FFD9C4" RenderTransformOrigin="0.5,0.5" />
                        <Path x:Name="PodHappyR" Data="M0,7 Q4.5,0 9,7" Stroke="#FFD9C4" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- In "attached" style the top 30px sit above the screen edge so only the bottom corners look rounded. -->
        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
                UseLayoutRounding="False"
                Margin="0,-30,0,0" Width="120" Height="60" Background="Black" CornerRadius="15"
                RenderTransformOrigin="0.5,0"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_MouseLeftButtonUp" MouseWheel="Island_MouseWheel"
                AllowDrop="True" DragEnter="Island_DragOver" DragOver="Island_DragOver" Drop="Island_Drop">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScale" />
            </Border.RenderTransform>
            <Grid x:Name="IslandContent">
                <Border x:Name="AccentGlow" Opacity="0" />

                <Grid x:Name="PanelsHost" Margin="0,30,0,0">

                    <!-- IDLE: two blinking eyes -->
                    <Grid x:Name="IdlePanel" Width="120" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <StackPanel x:Name="IdleEyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="EyesSleep" />
                                    <TranslateTransform x:Name="EyesLook" />
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <StackPanel.Effect>
                                <DropShadowEffect x:Name="EyesGlow" ShadowDepth="0" BlurRadius="9" Opacity="0" Color="White" />
                            </StackPanel.Effect>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="EyeL" Width="6" Height="10" Fill="White" RenderTransformOrigin="0.5,0.5" />
                                <Path x:Name="HappyL" Data="M0,7 Q4.5,0 9,7" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="10" Height="12" Margin="1,0">
                                <Ellipse x:Name="EyeR" Width="6" Height="10" Fill="White" RenderTransformOrigin="0.5,0.5" />
                                <Path x:Name="HappyR" Data="M0,7 Q4.5,0 9,7" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- COMPACT: generic left | center | right -->
                    <Grid x:Name="CompactPanel" Width="340" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                          Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="CompactAlertDot" Width="7" Height="7" Fill="{StaticResource ClaudeOrange}"
                                     Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="CompactClaudeGlyph" Text="✻" FontFamily="Segoe UI Symbol" FontSize="15"
                                       Foreground="{StaticResource ClaudeOrange}" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.52" Margin="0,0,7,0" Visibility="Collapsed">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="ClaudeSpin" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="CompactIcon" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                            <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="#2A2A2A" />
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="10,0" ClipToBounds="True">
                            <!-- StackPanel gives the text all the room it wants; the Grid clips it, so long lines can slide -->
                            <StackPanel x:Name="CompactTextHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CompactText" Foreground="White" FontWeight="SemiBold" FontSize="12.5" />
                            </StackPanel>
                            <StackPanel x:Name="CompactEyes" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse x:Name="EyeL2" Width="6" Height="10" Fill="White" Margin="3,0" RenderTransformOrigin="0.5,0.5" />
                                <Ellipse x:Name="EyeR2" Width="6" Height="10" Fill="White" Margin="3,0" RenderTransformOrigin="0.5,0.5" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                            <local:Visualizer x:Name="CompactViz" Width="28" Height="14" />
                            <TextBlock x:Name="CompactRight" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <!-- VOLUME OSD -->
                    <Grid x:Name="VolumePanel" Width="300" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center"
                          Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="VolOsdIconBtn" Margin="9,0,0,0" Padding="7,4,5,4" CornerRadius="9" Background="Transparent"
                                VerticalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="VolOsdIcon" FontFamily="{StaticResource IconFont}" Text="&#xE995;" Foreground="White"
                                           FontSize="14" VerticalAlignment="Center" />
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" Foreground="#99FFFFFF"
                                           FontSize="8" Margin="4,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <local:BarSlider x:Name="VolOsdBar" Grid.Column="1" Height="16" Margin="6,0,12,0" ShowThumb="False" Cursor="Hand" />
                        <TextBlock x:Name="VolOsdText" Grid.Column="2" Foreground="#CCFFFFFF" FontSize="11" Width="26"
                                   TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
                    </Grid>

                    <!-- EXPANDED -->
                    <Grid x:Name="ExpandedPanel" Width="480" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <Grid Grid.Row="0" Margin="20,4,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock x:Name="HeaderA" FontSize="13" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="HeaderB" FontSize="13" FontWeight="Bold" Foreground="#FFB060" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="HeaderClaudeDot" Width="6" Height="6" Fill="{StaticResource ClaudeOrange}"
                                         Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock FontSize="11.5" Foreground="#99FFFFFF" VerticalAlignment="Center">
                                    <Run x:Name="DateRun" /><Run Text="  " /><Run x:Name="TimeRun" Foreground="White" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="BatteryText" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="13"
                                        Padding="7,4" Click="MoreButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- tab content -->
                        <Grid x:Name="TabHost" Grid.Row="1" Margin="20,2,20,0">

                            <!-- HOME -->
                            <Grid x:Name="HomeTab" Height="118" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Button Style="{StaticResource CardButton}" Margin="0,0,5,0" Click="HomeClaude_Click">
                                    <Border x:Name="HomeClaudeCard" Height="112" CornerRadius="16" Padding="12,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                                <GradientStop Color="#3A2219" Offset="0" />
                                                <GradientStop Color="#93502F" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <TextBlock Text="Claude Code" FontSize="11" FontWeight="SemiBold" Foreground="#D9FFFFFF" />
                                            <Grid Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Ellipse Fill="#33FFFFFF" />
                                                <TextBlock x:Name="HomeClaudeIcon" Text="✻" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.52">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform x:Name="HomeClaudeSpin" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock x:Name="HomeClaudeBig" FontSize="24" FontWeight="Bold" Foreground="White" />
                                                <TextBlock x:Name="HomeClaudeSub" FontSize="10.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource CardButton}" Margin="5,0" Click="HomeMusic_Click">
                                    <Border x:Name="HomeMusicCard" Height="112" CornerRadius="16" Padding="12,10" Background="#2A2A2E">
                                        <Grid>
                                            <TextBlock x:Name="HomeMusicLabel" FontSize="11" FontWeight="SemiBold" Foreground="#D9FFFFFF" />
                                            <Border x:Name="HomeMusicArt" Width="40" Height="40" CornerRadius="10" Background="#33FFFFFF"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Grid VerticalAlignment="Bottom">
                                                <StackPanel Margin="0,0,32,0">
                                                    <TextBlock x:Name="HomeMusicTitle" FontSize="12.5" FontWeight="Bold" Foreground="White"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="HomeMusicSub" FontSize="10.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button x:Name="HomeMusicPlay" Style="{StaticResource CircleButton}" Width="26" Height="26"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11"
                                                        Content="&#xE768;" Click="Play_Click" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2" Style="{StaticResource CardButton}" Margin="5,0,0,0" Click="HomeFocus_Click">
                                    <Border x:Name="HomeFocusCard" Height="112" CornerRadius="16" Padding="12,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                                <GradientStop Color="#2A2150" Offset="0" />
                                                <GradientStop Color="#7050D8" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <TextBlock Text="Focus" FontSize="11" FontWeight="SemiBold" Foreground="#D9FFFFFF" />
                                            <Button x:Name="HomeFocusPlay" Style="{StaticResource CircleButton}" Width="28" Height="28"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11"
                                                    Content="&#xE768;" Foreground="#5B3FC4" Click="FocusPlay_Click" />
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock x:Name="HomeFocusBig" FontSize="24" FontWeight="Bold" Foreground="White" />
                                                <TextBlock x:Name="HomeFocusSub" FontSize="10.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </Grid>

                            <!-- CLAUDE -->
                            <Grid x:Name="ClaudeTab" Height="134" VerticalAlignment="Top" Visibility="Collapsed">
                                <Grid x:Name="ClaudeActive">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="212" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,2,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="15" Height="15" CornerRadius="4" Background="{StaticResource ClaudeOrange}">
                                                <TextBlock Text="✻" FontFamily="Segoe UI Symbol" FontSize="9.5" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="ClaudeProject" FontSize="11.5" Foreground="#CCFFFFFF" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Name="ClaudeTimer" FontSize="38" FontWeight="Bold" Foreground="White" Margin="0,0,0,-2" />
                                        <TextBlock x:Name="ClaudeStatus" FontSize="11.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border x:Name="ClaudeFileCard" Grid.Column="1" CornerRadius="12" Background="#16FFFFFF"
                                            BorderBrush="#12FFFFFF" BorderThickness="1" Padding="10,8" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="4" Background="#33FFFFFF" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ClaudeLang" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <TextBlock x:Name="ClaudeFile" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold" Foreground="White"
                                                           Margin="7,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ClaudeFileState" Grid.Column="2" FontSize="10" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border CornerRadius="6" Background="#2234C759" Margin="0,6,0,0" Padding="4,3">
                                                <StackPanel x:Name="ClaudeDiff" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Grid x:Name="ClaudeSteps" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                </Grid>

                                <Grid x:Name="ClaudeIdle" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="236" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,2,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="15" Height="15" CornerRadius="4" Background="{StaticResource ClaudeOrange}">
                                                <TextBlock Text="✻" FontFamily="Segoe UI Symbol" FontSize="9.5" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Claude Code" FontSize="11.5" Foreground="#CCFFFFFF" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="ClaudeJobsBig" FontSize="38" FontWeight="Bold" Foreground="White" Margin="0,0,0,-2" />
                                        <TextBlock x:Name="ClaudeJobsSub" FontSize="11.5" Foreground="#B3FFFFFF" />
                                        <Button x:Name="ClaudeConnectButton" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                                Margin="0,12,0,0" Click="ClaudeConnect_Click">
                                            <TextBlock x:Name="ClaudeConnectText" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="SemiBold" />
                                        </Button>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="12" Background="#16FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"
                                            Padding="10,8" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="ClaudeRecentTitle" FontSize="9.5" FontWeight="Bold" Foreground="#88FFFFFF" />
                                            <StackPanel x:Name="ClaudeRecentList" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- MUSIC -->
                            <Grid x:Name="MusicTab" Height="186" VerticalAlignment="Top" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="62" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ExpandedArt" Width="54" Height="54" CornerRadius="10" Background="#2A2A2A" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="White"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ArtistText" FontSize="12" Foreground="#99FFFFFF" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="LikeButton" Style="{StaticResource IconButton}" Content="&#xE006;" FontSize="15"
                                                Padding="6" Margin="0,0,6,0" VerticalAlignment="Top" Click="Like_Click"
                                                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" />
                                        <local:Visualizer x:Name="ExpandedViz" Width="36" Height="18"
                                                          VerticalAlignment="Top" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" ClipToBounds="True">
                                    <TextBlock x:Name="LyricCurrent" FontSize="16" FontWeight="Bold" Foreground="White"
                                               TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" LineHeight="21"
                                               LineStackingStrategy="BlockLineHeight" />
                                    <TextBlock x:Name="LyricNext" FontSize="12" Foreground="#77FFFFFF" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ElapsedText" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <local:BarSlider x:Name="ProgressSlider" Grid.Column="1" Height="18" Margin="4,0" />
                                    <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource Small}"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <Grid Grid.Row="3">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE995;" FontSize="13"
                                                Padding="5" Click="Mute_Click" />
                                        <local:BarSlider x:Name="VolumeSlider" Width="72" Height="18" Margin="4,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="13"
                                                Padding="7" Margin="0,0,2,0" Click="Shuffle_Click" Visibility="Collapsed" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="16" Padding="8" Click="Prev_Click" />
                                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="20"
                                                Padding="8" Margin="4,0" Click="Play_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="16" Padding="8" Click="Next_Click" />
                                        <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontSize="13"
                                                Padding="7" Margin="2,0,0,0" Click="Repeat_Click" Visibility="Collapsed" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="QueueButton" Style="{StaticResource IconButton}" Content="&#xE90B;" FontSize="13"
                                                Padding="7" Margin="0,0,4,0" Click="Queue_Click" Visibility="Collapsed" />
                                        <Button x:Name="SourceButton" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="Source_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SourceIcon" FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock x:Name="SourceText" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" MaxWidth="84" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Spotify queue: slides over the player -->
                                <Border x:Name="QueuePanel" Grid.RowSpan="3" Background="#F2141418" CornerRadius="12" Margin="0,0,0,4"
                                        BorderBrush="#14FFFFFF" BorderThickness="1" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="QueueSlide" />
                                    </Border.RenderTransform>
                                    <Grid Margin="10,6,6,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="QueueTitle" FontSize="11" FontWeight="Bold" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Padding="6"
                                                HorizontalAlignment="Right" Click="Queue_Click" />
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                                            <StackPanel x:Name="QueueList" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- FOCUS -->
                            <Grid x:Name="FocusTab" Height="128" VerticalAlignment="Top" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="14" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="FocusModeFocus" CornerRadius="9" Padding="9,2" Margin="0,0,4,0">
                                            <TextBlock x:Name="FocusModeFocusText" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                        <Border x:Name="FocusModeBreak" CornerRadius="9" Padding="9,2">
                                            <TextBlock x:Name="FocusModeBreakText" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="FocusTime" FontSize="46" FontWeight="Bold" Foreground="White" Margin="0,0,0,-4" />
                                    <TextBlock x:Name="FocusSub" FontSize="11.5" Foreground="#B3FFFFFF" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="15" Padding="10"
                                            Click="FocusReset_Click" />
                                    <Button x:Name="FocusPlayButton" Style="{StaticResource CircleButton}" Width="54" Height="54"
                                            FontSize="18" Margin="8,0" Content="&#xE768;" Click="FocusPlay_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="15" Padding="10"
                                            Click="FocusSkip_Click" />
                                </StackPanel>
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Background="#26FFFFFF"
                                        VerticalAlignment="Center">
                                    <Border x:Name="FocusProgress" CornerRadius="2" Background="#B79CFF" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="FocusProgressScale" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- NOTCHY CHAT (built in MainWindow.Chat.cs) -->
                            <Grid x:Name="ChatTab" VerticalAlignment="Top" Visibility="Collapsed" />

                            <!-- SHELF -->
                            <Grid x:Name="ShelfTab" Height="118" VerticalAlignment="Top" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Border x:Name="ShelfDropZone" CornerRadius="14" BorderThickness="1.5" Background="#0DFFFFFF">
                                    <Border.BorderBrush>
                                        <DrawingBrush Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="#40FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <RectangleGeometry Rect="0,0,5,5" />
                                                            <RectangleGeometry Rect="5,5,5,5" />
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.BorderBrush>
                                    <Grid>
                                        <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="20" Foreground="#99FFFFFF"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="ShelfEmptyText" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                      Margin="6,4">
                                            <StackPanel x:Name="ShelfItems" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="ShelfHint" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <Button x:Name="ShelfClear" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="8,2"
                                            VerticalAlignment="Center" Click="ShelfClear_Click">
                                        <TextBlock x:Name="ShelfClearText" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#B3FFFFFF" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- bottom nav (shelf tab lives in TabHost too, added below) -->
                        <Grid Grid.Row="2" Margin="12,0,12,6">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="NavPill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26"
                                        CornerRadius="13" Background="#24FFFFFF" Width="60">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="NavPillX" />
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="NavBar" Orientation="Horizontal" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
