                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border x:Name="ClaudeFileCard" Grid.Column="1" CornerRadius="12" Background="#16FFFFFF"
                                            BorderBrush="#12FFFFFF" BorderThickness="1" Padding="10,8" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="4" Background="#33FFFFFF" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ClaudeLang" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <TextBlock x:Name="ClaudeFile" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold" Foreground="White"
                                                           Margin="7,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ClaudeFileState" Grid.Column="2" FontSize="10" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border CornerRadius="6" Background="#2234C759" Margin="0,6,0,0" Padding="4,3">
                                                <StackPanel x:Name="ClaudeDiff" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- a tool waiting for permission: answered right here -->
                                    <Border x:Name="ClaudeAskCard" Grid.Column="1" CornerRadius="12" Background="#1CE8825F"
                                            BorderBrush="#40E8825F" BorderThickness="1" Padding="10,8" VerticalAlignment="Top" Margin="0,2,0,0"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="4" Background="{StaticResource ClaudeOrange}" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ClaudeAskTool" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <TextBlock x:Name="ClaudeAskWants" Grid.Column="1" FontSize="11" Foreground="#CCFFFFFF" Margin="7,0,6,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="ClaudeAskMore" Grid.Column="2" FontSize="10" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border CornerRadius="6" Background="#33000000" Margin="0,6,0,0" Padding="6,4">
                                                <TextBlock x:Name="ClaudeAskWhat" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#E6FFFFFF"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                <Button x:Name="ClaudeDenyButton" Style="{StaticResource ClaudeGhost}" Click="ClaudeDeny_Click" Margin="0,0,6,0">
                                                    <TextBlock x:Name="ClaudeDenyText" />
                                                </Button>
                                                <Button x:Name="ClaudeAllowButton" Style="{StaticResource ClaudePill}" Click="ClaudeAllow_Click" Padding="12,4">
                                                    <TextBlock x:Name="ClaudeAllowText" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid x:Name="ClaudeSteps" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                </Grid>

                                <Grid x:Name="ClaudeIdle" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="236" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,2,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="15" Height="15" CornerRadius="4" Background="{StaticResource ClaudeOrange}">
                                                <TextBlock Text="✻" FontFamily="Segoe UI Symbol" FontSize="9.5" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Claude Code" FontSize="11.5" Foreground="#CCFFFFFF" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="ClaudeJobsBig" FontSize="38" FontWeight="Bold" Foreground="White" Margin="0,0,0,-2" />
                                        <TextBlock x:Name="ClaudeJobsSub" FontSize="11.5" Foreground="#B3FFFFFF" />
                                        <Button x:Name="ClaudeConnectButton" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                                Margin="0,12,0,0" Click="ClaudeConnect_Click">
                                            <TextBlock x:Name="ClaudeConnectText" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="SemiBold" />
                                        </Button>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="12" Background="#16FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"
                                            Padding="10,8" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="ClaudeRecentTitle" FontSize="9.5" FontWeight="Bold" Foreground="#88FFFFFF" />
                                            <StackPanel x:Name="ClaudeRecentList" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- MUSIC -->
                            <Grid x:Name="MusicTab" Height="186" VerticalAlignment="Top" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="62" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ExpandedArt" Width="54" Height="54" CornerRadius="10" Background="#2A2A2A" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="White"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ArtistText" FontSize="12" Foreground="#99FFFFFF" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="LikeButton" Style="{StaticResource IconButton}" Content="&#xE006;" FontSize="15"
                                                Padding="6" Margin="0,0,6,0" VerticalAlignment="Top" Click="Like_Click"
                                                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" />
                                        <local:Visualizer x:Name="ExpandedViz" Width="36" Height="18"
                                                          VerticalAlignment="Top" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" ClipToBounds="True">
                                    <TextBlock x:Name="LyricCurrent" FontSize="16" FontWeight="Bold" Foreground="White"
                                               TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" LineHeight="21"
                                               LineStackingStrategy="BlockLineHeight" />
                                    <TextBlock x:Name="LyricNext" FontSize="12" Foreground="#77FFFFFF" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ElapsedText" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <local:BarSlider x:Name="ProgressSlider" Grid.Column="1" Height="18" Margin="4,0" />
                                    <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource Small}"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <Grid Grid.Row="3">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE995;" FontSize="13"
                                                Padding="5" Click="Mute_Click" />
                                        <local:BarSlider x:Name="VolumeSlider" Width="72" Height="18" Margin="4,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="13"
                                                Padding="7" Margin="0,0,2,0" Click="Shuffle_Click" Visibility="Collapsed" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="16" Padding="8" Click="Prev_Click" />
                                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="20"
                                                Padding="8" Margin="4,0" Click="Play_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="16" Padding="8" Click="Next_Click" />
                                        <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontSize="13"
                                                Padding="7" Margin="2,0,0,0" Click="Repeat_Click" Visibility="Collapsed" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="QueueButton" Style="{StaticResource IconButton}" Content="&#xE90B;" FontSize="13"
                                                Padding="7" Margin="0,0,4,0" Click="Queue_Click" Visibility="Collapsed" />
                                        <Button x:Name="SourceButton" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="Source_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SourceIcon" FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock x:Name="SourceText" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" MaxWidth="84" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Spotify queue: slides over the player -->
                                <Border x:Name="QueuePanel" Grid.RowSpan="3" Background="#F2141418" CornerRadius="12" Margin="0,0,0,4"
                                        BorderBrush="#14FFFFFF" BorderThickness="1" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="QueueSlide" />
                                    </Border.RenderTransform>
                                    <Grid Margin="10,6,6,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="QueueTitle" FontSize="11" FontWeight="Bold" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Padding="6"
                                                HorizontalAlignment="Right" Click="Queue_Click" />
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                                            <StackPanel x:Name="QueueList" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- FOCUS -->
                            <!-- FOCUS: a ring with Notchy's eyes, the time (scroll it, or use the little dial), quick lengths,
                                 what you're focusing on, and today's numbers (MainWindow.Focus.cs) -->
                            <Grid x:Name="FocusTab" Height="150" VerticalAlignment="Top" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="124" />
                                </Grid.ColumnDefinitions>

                                <!-- the ring and its face -->
                                <Grid Width="96" Height="96" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Ellipse Width="88" Height="88" Stroke="#18FFFFFF" StrokeThickness="6.5" />
                                    <Path x:Name="FocusRingArc" Width="96" Height="96" StrokeThickness="6.5" Stroke="#B79CFF"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Width="64" Height="64" Fill="#0AFFFFFF" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="FocusFaceLook" />
                                        </StackPanel.RenderTransform>
                                        <Rectangle x:Name="FocusEyeL" Width="8.5" Height="14" RadiusX="4.25" RadiusY="4.25" Fill="#B79CFF" Margin="0,0,6,0"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform><ScaleTransform x:Name="FocusEyeLScale" /></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle x:Name="FocusEyeR" Width="8.5" Height="14" RadiusX="4.25" RadiusY="4.25" Fill="#B79CFF" Margin="6,0,0,0"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform><ScaleTransform x:Name="FocusEyeRScale" /></Rectangle.RenderTransform>
                                        </Rectangle>
                                    </StackPanel>
                                    <Canvas x:Name="FocusZz" IsHitTestVisible="False" Opacity="0">
                                        <TextBlock x:Name="FocusZ1" Text="z" FontSize="11" FontWeight="Bold" Foreground="#AAFFFFFF" Canvas.Left="64" Canvas.Top="20" />
                                        <TextBlock x:Name="FocusZ2" Text="z" FontSize="8" FontWeight="Bold" Foreground="#88FFFFFF" Canvas.Left="72" Canvas.Top="11" />
                                    </Canvas>
                                </Grid>

                                <!-- task, time, dial, lengths, buttons -->
                                <Grid Grid.Column="1" Margin="2,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBox x:Name="FocusTaskBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                                 FontSize="12" Padding="0,3,0,3" FocusVisualStyle="{x:Null}" MaxLength="80" />
                                        <TextBlock x:Name="FocusTaskHint" FontSize="12" Foreground="#66FFFFFF" Margin="2,3,0,0" IsHitTestVisible="False" />
                                        <Rectangle Height="1" VerticalAlignment="Bottom" StrokeDashArray="3 3" Stroke="#33FFFFFF" StrokeThickness="1" />
                                    </Grid>
                                    <!-- the time: minutes are a little reel that rolls when they change -->
                                    <StackPanel x:Name="FocusTimeRow" Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0" Background="Transparent"
                                                Cursor="SizeNS" HorizontalAlignment="Left">
                                        <Canvas x:Name="FocusReel" Height="44" ClipToBounds="True" />
                                        <TextBlock x:Name="FocusSeconds" FontSize="38" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FocusUnit" FontSize="11.5" FontWeight="SemiBold" Foreground="#77FFFFFF" Margin="7,0,0,9"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <!-- a small dial that slides with the time -->
                                    <Grid x:Name="FocusDial" Grid.Row="2" Width="132" Height="10" HorizontalAlignment="Left" Margin="0,-2,0,0"
                                          ClipToBounds="True" Background="Transparent" Cursor="SizeWE">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="0.28" />
                                                <GradientStop Color="#FF000000" Offset="0.72" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Canvas x:Name="FocusTicks">
                                            <Canvas.RenderTransform><TranslateTransform x:Name="FocusTicksX" /></Canvas.RenderTransform>
                                        </Canvas>
                                        <Rectangle x:Name="FocusNeedle" Width="2" Height="10" RadiusX="1" RadiusY="1" Fill="#B79CFF"
                                                   HorizontalAlignment="Left" Margin="65,0,0,0" />
                                    </Grid>
                                    <StackPanel x:Name="FocusChips" Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0" />
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12" Width="30" Height="30" Padding="0"
                                                Background="#14FFFFFF" Click="FocusReset_Click" />
                                        <Button x:Name="FocusPlayButton" Style="{StaticResource CircleButton}" Width="40" Height="40"
                                                FontSize="14" Margin="8,0" Content="&#xE768;" Click="FocusPlay_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="12" Width="30" Height="30" Padding="0"
                                                Background="#14FFFFFF" Click="FocusSkip_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- today -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="14" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="10,8,10,7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="FocusTodayLabel" FontSize="10" Foreground="#77FFFFFF" />
                                            <TextBlock x:Name="FocusTodayText" Grid.Row="1" FontSize="15" FontWeight="Bold" Foreground="White" />
                                            <TextBlock x:Name="FocusStreakText" Grid.Row="2" FontSize="10.5" Foreground="#FFD49A" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid x:Name="FocusWeek" Grid.Row="3" Height="26" VerticalAlignment="Bottom" Margin="0,4,0,0" />
                                            <Grid x:Name="FocusWeekLabels" Grid.Row="4" Margin="0,2,0,0" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="FocusQuietPill" Grid.Row="1" CornerRadius="11" Padding="8,3,9,3" Margin="0,6,0,0" Cursor="Hand"
                                            HorizontalAlignment="Stretch" MouseLeftButtonUp="FocusQuiet_Click" Background="#10FFFFFF">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="FocusQuietMoon" Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       VerticalAlignment="Center" Margin="0,1,5,0" />
                                            <TextBlock x:Name="FocusQuietText" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- RELÓGIO: the Timer and Alarmes pages, one above the other (built in MainWindow.Clock.cs) -->
                            <Grid x:Name="ClockTab" Height="150" VerticalAlignment="Top" Visibility="Collapsed" ClipToBounds="True" />

                            <!-- NOTCHY CHAT (built in MainWindow.Chat.cs) -->
                            <Grid x:Name="ChatTab" VerticalAlignment="Top" Visibility="Collapsed" />

                            <!-- WHAT'S NEW (MainWindow.WhatsNew.cs): highlights and the full notes, after an update -->
                            <Grid x:Name="NewsTab" Height="186" VerticalAlignment="Top" Visibility="Collapsed" />

                            <!-- SHELF -->
                            <!-- DOWNLOADS (MainWindow.Transfer.cs) -->
                            <Grid x:Name="DownloadsTab" Height="96" VerticalAlignment="Top" Visibility="Collapsed">
                                <ScrollViewer x:Name="DownloadsScroll" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                                    <StackPanel x:Name="DownloadsList" />
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="ShelfTab" Height="118" VerticalAlignment="Top" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Border x:Name="ShelfDropZone" CornerRadius="14" BorderThickness="1.5" Background="#0DFFFFFF">
                                    <Border.BorderBrush>
                                        <DrawingBrush Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="#40FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <RectangleGeometry Rect="0,0,5,5" />
                                                            <RectangleGeometry Rect="5,5,5,5" />
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.BorderBrush>
                                    <Grid>
                                        <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas x:Name="ShelfFace" Width="28" Height="26" HorizontalAlignment="Center">
                                                <Canvas.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                                                </Canvas.LayoutTransform>
                                                <!-- a little file that falls into the box (hidden once it's inside) -->
                                                <Canvas>
                                                    <Canvas.Clip>
                                                        <RectangleGeometry Rect="0,-20,28,30.2" />
                                                    </Canvas.Clip>
                                                    <Path x:Name="ShelfFallingFile" Opacity="0" Stroke="#6EE7C4" StrokeThickness="1.4" Fill="#336EE7C4"
                                                          StrokeLineJoin="Round"
                                                          Data="M11.6,0 H15.2 L17.4,2.2 V7 A1,1 0 0 1 16.4,8 H11.6 A1,1 0 0 1 10.6,7 V1 A1,1 0 0 1 11.6,0 Z">
                                                        <Path.RenderTransform>
                                                            <TranslateTransform x:Name="ShelfFileY" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Canvas>
                                                <Path Data="M5,10.5 V21.5 A2,2 0 0 0 7,23.5 H21 A2,2 0 0 0 23,21.5 V10.5" Stroke="#99FFFFFF"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                <Rectangle Canvas.Left="3" Canvas.Top="5.5" Width="22" Height="5" RadiusX="1.5" RadiusY="1.5"
                                                           Stroke="#99FFFFFF" StrokeThickness="1.6">
                                                    <Rectangle.RenderTransform>
                                                        <RotateTransform x:Name="ShelfLid" CenterX="0" CenterY="5" />
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                                <StackPanel Canvas.Left="9" Canvas.Top="13.2" Orientation="Horizontal">
                                                    <StackPanel.RenderTransform>
                                                        <TranslateTransform x:Name="ShelfLook" />
                                                    </StackPanel.RenderTransform>
                                                    <StackPanel.Effect>
                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.9" Color="#6EE7C4" />
                                                    </StackPanel.Effect>
                                                    <Grid Width="4" Height="6" Margin="0.5,0">
                                                        <Rectangle x:Name="ShelfEyeL" Width="2.3" Height="4.4" RadiusX="1.15" RadiusY="1.15" Fill="#6EE7C4"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                            <Rectangle.RenderTransform>
                                                                <ScaleTransform x:Name="ShelfEyeLScale" />
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>
                                                        <Path x:Name="ShelfHappyL" Data="M0,3 Q1.8,0 3.6,3" Stroke="#6EE7C4" StrokeThickness="1.3"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" Visibility="Collapsed" />
                                                    </Grid>
                                                    <Grid Width="4" Height="6" Margin="0.5,0">
                                                        <Rectangle x:Name="ShelfEyeR" Width="2.3" Height="4.4" RadiusX="1.15" RadiusY="1.15" Fill="#6EE7C4"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                            <Rectangle.RenderTransform>
                                                                <ScaleTransform x:Name="ShelfEyeRScale" />
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>
                                                        <Path x:Name="ShelfHappyR" Data="M0,3 Q1.8,0 3.6,3" Stroke="#6EE7C4" StrokeThickness="1.3"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" Visibility="Collapsed" />
                                                    </Grid>
                                                </StackPanel>
                                            </Canvas>
                                            <TextBlock x:Name="ShelfEmptyText" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                      Margin="6,4">
                                            <StackPanel x:Name="ShelfItems" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <!-- a teal glow along the edge when something is put on the shelf -->
                                <Border x:Name="ShelfGlow" CornerRadius="14" BorderThickness="1.5" BorderBrush="#6EE7C4" Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.9" Color="#6EE7C4" />
                                    </Border.Effect>
                                </Border>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ShelfHint" Style="{StaticResource Small}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ShelfClear" Style="{StaticResource IconButton}" Padding="8,2"
                                                VerticalAlignment="Center" Click="ShelfClear_Click">
                                            <TextBlock x:Name="ShelfClearText" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#B3FFFFFF" />
                                        </Button>
                                        <Button x:Name="ShelfSelect" Style="{StaticResource IconButton}" Padding="8,2" Margin="2,0,0,0"
                                                VerticalAlignment="Center" Click="ShelfSelect_Click">
                                            <TextBlock x:Name="ShelfSelectText" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#B3FFFFFF" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- bottom nav (shelf tab lives in TabHost too, added below) -->
                        <Grid Grid.Row="2" Margin="12,0,12,6">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="NavPill" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26"
                                        CornerRadius="13" Background="#24FFFFFF" Width="60">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="NavPillX" />
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="NavBar" Orientation="Horizontal" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Claude working: an orange light running around the island's edge (MainWindow.ClaudeFace.cs) -->
        <Path x:Name="ClaudeTrack" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="Collapsed" StrokeThickness="2.2" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0" />
        <Path x:Name="ClaudeLight" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="Collapsed" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round" RenderTransformOrigin="0.5,0">
            <Path.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="1" Color="#E8825F" />
            </Path.Effect>
        </Path>

        <!-- download / copy progress: a green light that fills the island's outline (MainWindow.Transfer.cs) -->
        <Path x:Name="TransferTrack" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="Collapsed" StrokeThickness="2.2" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0" />
        <Path x:Name="TransferLight" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="Collapsed" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round" RenderTransformOrigin="0.5,0">
            <Path.Effect>
                <DropShadowEffect x:Name="TransferLightGlow" ShadowDepth="0" BlurRadius="10" Opacity="1" />
            </Path.Effect>
        </Path>

        <!-- focus running on the small island: the light fills the edge as time goes by (MainWindow.Focus.cs) -->
        <Path x:Name="FocusTrack" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="Collapsed" StrokeThickness="2.2" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0" />
        <Path x:Name="FocusLight" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="Collapsed" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round" RenderTransformOrigin="0.5,0">
            <Path.Effect>
                <DropShadowEffect x:Name="FocusLightGlow" ShadowDepth="0" BlurRadius="10" Opacity="1" />
            </Path.Effect>
        </Path>

        <!-- opening animation: the light that runs around the island's edge (MainWindow.Intro.cs) -->
        <Path x:Name="IntroLight" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="Collapsed" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round" RenderTransformOrigin="0.5,0">
            <Path.Effect>
                <DropShadowEffect x:Name="IntroLightGlow" ShadowDepth="0" BlurRadius="10" Opacity="1" />
            </Path.Effect>
        </Path>
    </Grid>
</Window>
